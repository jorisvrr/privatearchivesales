{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node node_modules/vite/bin/vite.js build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|media/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/invitations",
      "destination": "/about",
      "statusCode": 301
    },
    {
      "source": "/invitations/:path*",
      "destination": "/about",
      "statusCode": 301
    },
    {
      "source": "/waitlist",
      "destination": "/about",
      "statusCode": 301
    },
    {
      "source": "/waitlist/:path*",
      "destination": "/about",
      "statusCode": 301
    },
    {
      "source": "/archive/chore-jacket",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/archive/long-coat",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/archive/poplin-shirt",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/archive/ribbed-jumper",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/archive/wide-leg-trouser",
      "destination": "/",
      "statusCode": 301
    }
  ]
}

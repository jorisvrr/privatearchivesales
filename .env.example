# Orvel — server configuration (set these in Vercel → Project → Settings → Environment Variables).
# Nothing here is configured yet. Until it is, both forms answer "not open yet" and never show success.

# Invitation list (second invitation). Choose one provider.
MAILING_PROVIDER=            # buttondown | mailchimp
BUTTONDOWN_API_KEY=
BUTTONDOWN_TAGS=wave-2
MAILING_DOUBLE_OPT_IN=       # 1 if the Buttondown newsletter sends a confirmation email first (changes the success copy)
MAILCHIMP_API_KEY=           # ends in the data centre, e.g. …-us21
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_DOUBLE_OPT_IN=1    # 1 = confirmation email before the address counts (recommended for EU signups)
MAILCHIMP_TAGS=wave-2

# Label enquiries ("Tell us about your stock"). Choose one provider.
ENQUIRY_PROVIDER=            # resend | webhook
RESEND_API_KEY=
ENQUIRY_TO=                  # Orvel's inbox, receives each enquiry (reply-to is the founder)
ENQUIRY_FROM=                # e.g. "Orvel <enquiries@your-domain>", on a domain verified in Resend
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# Local tests only — refused on Vercel.
# ORVEL_ALLOW_MOCK=1 MAILING_PROVIDER=mock ENQUIRY_PROVIDER=mock

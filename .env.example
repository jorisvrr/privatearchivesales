# Mino — server configuration (set these in Vercel → Project → Settings → Environment Variables).
# Nothing here is configured yet. Until it is, the forms answer "not open yet" and never show success.
# Check with: node --env-file=.env scripts/check-config.mjs

# Drop waitlists (one entry per email per drop, stored as per-drop tags). Choose one provider.
WAITLIST_PROVIDER=           # buttondown | mailchimp
BUTTONDOWN_API_KEY=
WAITLIST_DOUBLE_OPT_IN=      # 1 if the Buttondown newsletter sends a confirmation email first
MAILCHIMP_API_KEY=           # ends in the data centre, e.g. …-us21
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_DOUBLE_OPT_IN=1    # 1 = confirmation email before the address counts (recommended for EU signups)

# Order verification for first access, per drop. Key = DROP_ + drop id upper-cased, "-" → "_".
# Shopify (Drop.verification = 'shopify'): an Admin API token with read_orders on the label's store.
# DROP_STUDIO_ARCHIVE_001_SHOPIFY_DOMAIN=studio.myshopify.com
# DROP_STUDIO_ARCHIVE_001_SHOPIFY_TOKEN=
# Webhook (Drop.verification = 'webhook'): POST { drop, label, orderNumber, email } → { "verified": true | false }
# DROP_STUDIO_ARCHIVE_001_VERIFY_URL=
# DROP_STUDIO_ARCHIVE_001_VERIFY_SECRET=

# Archive-sale enquiries from founders ("Plan an archive sale", work email only). Choose one provider.
ENQUIRY_PROVIDER=            # resend | webhook
RESEND_API_KEY=
ENQUIRY_TO=                  # Mino's inbox, receives each enquiry (reply-to is the founder's work email)
ENQUIRY_FROM=                # a sender on a domain verified in Resend — no real Mino domain exists yet
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# Local tests only — refused on Vercel.
# MINO_ALLOW_MOCK=1 WAITLIST_PROVIDER=mock ENQUIRY_PROVIDER=mock
